

<div>
  <h1 class="font-semibold text-4xl">System Information Portal</h1>
  <p class="mt-4">View, edit, or delete existing assets, or create a new one.</p>
  
  </div>

<div class="flex items-start gap-2 mt-4">

<div class="relative inline-block group">
  <button class="bg-slate-900 font-medium  overflow-auto inline-flex items-center justify-center whitespace-nowrap border border-slate-400 gap-2 w-44 h-10 rounded-full">Select an asset <%=icon "chevron-down", class: "group-hover:rotate-180 transition duration-350 ease-in-out" %></button>
  <div class="hidden bg-slate-800 border border-slate-800 rounded-lg group-hover:block">
   
    <% @sysinfo.each do |i| %>
  
      <a class="block cursor-pointer group-hover:pointer-events-auto pointer-events-none border border-transparent hover:bg-slate-900 rounded-sm" href="/sysinfos/<%= i.id%>">
        <%= i.name %>

   
  <% end %>
  </div>
</div>








<div class="relative">

  <a href="<%= new_sysinfo_path %>" class="gap-2 inline-flex items-center justify-center w-44 h-10 border bg-white text-slate-900 hover:text-white transition duration-200 font-medium ease-in-out hover:bg-green-800 rounded-full border-green-800">
  Create new asset <%= icon "plus" %>
</a>
  
</div>






</div>
 

















