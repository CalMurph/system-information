<div class="flex w-full">
    <h1 class="font-semibold text-4xl">Json Data for <em><%= @name %></em></h1>


     <%= link_to "Back", :back, class: "hover:-translate-y-1 transition border w-min h-min p-2  ml-4 bg-slate-900 border-slate-400 rounded-full items-end justify-end" %>

    


    </div>
 <br/>
  <hr/>
  <br/>

  <em>Imported at <%= @raw_data.created_at %> </em>


<div class="flex  justify-center">
<div data-controller="clipboard" class="flex relative bg-slate-900 mt-8 border w-[900] border-slate-900 rounded-lg h-[500] text-wrap overflow-y-auto mb-4" >
  <!-- The Source -->
  <pre 
    
         class="p-2 mt-8 rounded text-wrap" 
         data-clipboard-target="source">
             <%= JSON.pretty_generate(@json_data) %>
   
             </pre>

  <!-- The Trigger -->
  <button type="button" 
          
          class="absolute right-4 top-4 cursor-pointer transition hover:-translate-y-1"
          id="copy"
          data-action="clipboard#copy" 
          data-clipboard-target="button">
   <%= icon "copy" %>
  </button>

    <button type="button" id="copied"  class="absolute right-4 top-4 cursor-pointer hidden transition text-green-400" >
          
         
   <%= icon "check-check" %>
  </button>
</div>
</div>
